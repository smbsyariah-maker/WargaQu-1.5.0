                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>

                <div class="pt-2 border-t border-slate-100 mt-2 flex items-center justify-between text-xs">
                    <div class="flex items-center space-x-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span class="text-slate-600">Iuran Bulan Ini: <strong class="text-emerald-700">Lunas</strong></span>
                    </div>
                    <button onclick="openSubMenu('Iuran & Kas RT', 'Kelola Tagihan, Riwayat Pembayaran & Kas RT', 'kas')" class="font-semibold text-rtqu-600 hover:text-rtqu-800 flex items-center">
                        Detail Kas <svg class="w-3.5 h-3.5 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
            </div>

            <!-- BANNER AKSI CEPAT - BAYAR IURAN (STYLE WARGQU) -->
