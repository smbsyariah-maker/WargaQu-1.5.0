                        <div class="text-[10px] text-emerald-200">Iuran Kebersihan & Keamanan (Rp 50.000)</div>
                    </div>
                </div>
                <div class="bg-emerald-700/80 p-1.5 rounded-lg text-emerald-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </div>
            </button>

