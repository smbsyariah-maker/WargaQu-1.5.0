            <!-- Tab 4: Laporan RT -->
            <button onclick="setActiveTab(this); openSubMenu('Laporan RT', 'Transparansi laporan keuangan dan kegiatan RT 03', 'laporan')" class="nav-tab text-slate-400 hover:text-rtqu-600 flex flex-col items-center transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span class="text-[10px] font-medium mt-1">Laporan RT</span>
            </button>

            <!-- Tab 5: Akun Saya -->
            <button onclick="goBackMain()" class="text-slate-400 hover:text-rtqu-600 flex flex-col items-center transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span class="text-[10px] font-medium mt-1">Utama</span>
            </button>
        </div>

        <!-- MODAL SUB-MENU INTERAKTIF -->
        <div id="subMenuModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-end justify-center hidden opacity-0 transition-opacity duration-300">
            <div class="bg-white w-full max-w-md rounded-t-[32px] p-5 shadow-2xl transform translate-y-full transition-transform duration-300" id="modalContainer">
                <div class="w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-4"></div>
                
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center space-x-2.5">
                        <div class="w-8 h-8 rounded-xl bg-emerald-100 text-rtqu-700 flex items-center justify-center font-bold text-sm" id="modalBadge">
                            RT
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-slate-800" id="modalTitle">Judul Sub-Menu</h3>
                            <p class="text-xs text-slate-500" id="modalDesc">Deskripsi ringkas modul</p>
                        </div>
                    </div>
                    <button onclick="closeSubMenu()" class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center font-bold">✕</button>
                </div>

                <!-- Konten Dinamis Submenu -->
                <div id="modalContent" class="py-2">
                    <!-- Loaded via JS -->
                </div>

                <button onclick="closeSubMenu()" class="w-full mt-4 bg-rtqu-700 hover:bg-rtqu-800 text-white font-bold py-3 rounded-2xl shadow-md transition text-xs">
                    Tutup Modul
                </button>
            </div>
        </div>

    </div>

    <script>
        // Toggle saldo kas RT (Sembunyikan/Tampilkan)
        let isHidden = false;
        function toggleVisibility() {
            const saldo = document.getElementById('saldoKasText');
            const eyeIcon = document.getElementById('eyeIcon');
            if (!isHidden) {
                saldo.innerText = '••••••••';
                isHidden = true;
            } else {
                saldo.innerText = '12.450.000';
                isHidden = false;
            }
        }

        // Buka Sub-menu Modal
        function openSubMenu(title, desc, type) {
            const modal = document.getElementById('subMenuModal');
            const container = document.getElementById('modalContainer');
            const modalTitle = document.getElementById('modalTitle');
            const modalDesc = document.getElementById('modalDesc');
            const modalContent = document.getElementById('modalContent');

            modalTitle.innerText = title;
            modalDesc.innerText = desc;

            // Generate isi modal sesuai modul yang diklik
            let contentHtml = '';
            if (type === 'keuangan' || type === 'kas') {
                contentHtml = `
                    <div class="space-y-2 mt-2">
                        <button class="w-full text-left p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 border border-slate-100 flex justify-between items-center text-xs font-semibold text-slate-700">
                            <span>💳 Status Iuran Warga Bulanan</span>
                            <span class="text-emerald-600">Lunas ›</span>
                        </button>
                        <button class="w-full text-left p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 border border-slate-100 flex justify-between items-center text-xs font-semibold text-slate-700">
                            <span>📊 Laporan Arus Kas Masuk & Keluar</span>
                            <span class="text-slate-400">Lihat ›</span>
                        </button>
                        <button class="w-full text-left p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 border border-slate-100 flex justify-between items-center text-xs font-semibold text-slate-700">
                            <span>📥 Unduh Rekap Bulanan (PDF)</span>
                            <span class="text-slate-400">Download ›</span>
                        </button>
                    </div>
                `;
            } else if (type === 'warga') {
                contentHtml = `
                    <div class="space-y-2 mt-2">
                        <button class="w-full text-left p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 border border-slate-100 flex justify-between items-center text-xs font-semibold text-slate-700">
                            <span>👨‍👩‍👧‍👦 Daftar Kepala Keluarga (RT 03)</span>
                            <span class="text-slate-400">48 KK ›</span>
                        </button>
                        <button class="w-full text-left p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 border border-slate-100 flex justify-between items-center text-xs font-semibold text-slate-700">
                            <span>👔 Pengurus RT & Nomor Kontak</span>
                            <span class="text-slate-400">6 Orang ›</span>
                        </button>
                    </div>
                `;
            } else if (type === 'surat') {
                contentHtml = `
                    <div class="space-y-2 mt-2">
                        <button class="w-full text-left p-3 rounded-xl bg-emerald-50 border border-emerald-200 flex justify-between items-center text-xs font-bold text-rtqu-800">
                            <span>📝 Buat Surat Pengantar Baru</span>
                            <span class="text-emerald-600">+ Ajukan</span>
                        </button>
                        <button class="w-full text-left p-3 rounded-xl bg-slate-50 hover:bg-emerald-50 border border-slate-100 flex justify-between items-center text-xs font-semibold text-slate-700">
                            <span>📑 Riwayat Pengajuan Surat</span>
                            <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full">1 Diproses</span>
                        </button>
                    </div>
                `;
            } else {
                contentHtml = `
                    <div class="p-4 rounded-2xl bg-emerald-50 text-emerald-900 text-xs text-center border border-emerald-100">
                        Modul <strong>${title}</strong> siap digunakan. Semua sub-menu telah disederhanakan agar mudah diakses oleh warga dan pengurus.
                    </div>
                `;
            }

            modalContent.innerHTML = contentHtml;

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                container.classList.remove('translate-y-full');
            }, 10);
        }

        // Tutup Sub-menu Modal
        function closeSubMenu() {
            const modal = document.getElementById('subMenuModal');
            const container = document.getElementById('modalContainer');

            container.classList.add('translate-y-full');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        // Tab Navigation State Switch
        function setActiveTab(element) {
            document.querySelectorAll('.nav-tab').forEach(tab => {
                tab.classList.remove('text-rtqu-700');
                tab.classList.add('text-slate-400');
            });
            element.classList.remove('text-slate-400');
            element.classList.add('text-rtqu-700');
        }

        // Simulasi Kembali ke Halaman Utama WargaQu
        function goBackMain() {
            alert("Kembali ke Beranda Utama WargaQu");
        }
    </script>
</body>
</html>