                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <span class="text-[11px] font-bold text-slate-700 text-center leading-tight">Kegiatan</span>
                        <span class="text-[9px] text-slate-400 mt-0.5">Jadwal & Acara</span>
                    </button>

                    <!-- Menu 5: Aspirasi & Laporan -->
                    <button onclick="openSubMenu('Aspirasi & Laporan', 'Pengaduan fasilitas, saran, dan masukan warga.', 'aspirasi')" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-slate-50 hover:bg-emerald-50 border border-slate-100 hover:border-emerald-200 transition active:scale-95 group">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-100 group-hover:bg-rtqu-600 text-rtqu-700 group-hover:text-white flex items-center justify-center mb-2 transition shadow-sm">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
