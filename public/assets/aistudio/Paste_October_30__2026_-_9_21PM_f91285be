                    <button onclick="openSubMenu('Pengaturan RT', 'Konfigurasi Hak Akses & Parameter Modul RT', 'settings')" class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 active:scale-95 flex items-center justify-center transition relative">
