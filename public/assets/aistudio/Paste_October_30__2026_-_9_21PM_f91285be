                    </div>
                </div>
            </div>

            <!-- SPACING BOTTOM CAROUSEL -->
            <div class="h-4"></div>
        </div>

        <!-- NAVIGASI BAWAH MODUL RTQU (ACCENT EMERALD) -->
        <div class="bg-white border-t border-slate-200 px-3 py-2 flex items-center justify-around z-20">
            <!-- Tab 1: Beranda RT -->
            <button onclick="setActiveTab(this)" class="nav-tab text-rtqu-700 flex flex-col items-center">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </svg>
                <span class="text-[10px] font-bold mt-1">Beranda RT</span>
