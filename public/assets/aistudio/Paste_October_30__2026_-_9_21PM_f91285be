                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 58h2m-2-4h2m-2-4h2m8-4a9 9 0 11-18 0 9 9 0 0118 0zM12 9v2m0 4h.01"></path>
                    </svg>
                </div>
