                        </div>
                        <span class="text-[11px] font-bold text-slate-700 text-center leading-tight">Aspirasi</span>
                        <span class="text-[9px] text-slate-400 mt-0.5">Aduan Warga</span>
                    </button>

                    <!-- Menu 6: Pos Ronda / Siaga -->
                    <button onclick="openSubMenu('Siaga & Ronda', 'Jadwal siskamling dan nomor kontak darurat RT.', 'ronda')" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-slate-50 hover:bg-emerald-50 border border-slate-100 hover:border-emerald-200 transition active:scale-95 group">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-100 group-hover:bg-rtqu-600 text-rtqu-700 group-hover:text-white flex items-center justify-center mb-2 transition shadow-sm">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
