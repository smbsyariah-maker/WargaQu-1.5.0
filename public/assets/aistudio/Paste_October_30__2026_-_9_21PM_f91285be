                        </div>
                    </div>
                    <div class="text-right">
                        <div class="text-[10px] text-emerald-200">No. Rumah</div>
                        <div class="text-xs font-bold text-emerald-300 bg-rtqu-900 px-2 py-1 rounded-lg border border-emerald-500/30">
                            Blok A No. 12
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SCROLLABLE CONTENT BODY -->
        <div class="flex-1 overflow-y-auto px-4 py-4 space-y-4 hide-scrollbar">
            
