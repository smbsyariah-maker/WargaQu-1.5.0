                </div>

                <!-- Grid 3x2 -->
                <div class="grid grid-cols-3 gap-3">
                    
                    <!-- Menu 1: Keuangan -->
                    <button onclick="openSubMenu('Keuangan RT', 'Pencatatan kas, iuran warga, dan transparansi laporan.', 'keuangan')" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-slate-50 hover:bg-emerald-50 border border-slate-100 hover:border-emerald-200 transition active:scale-95 group">
