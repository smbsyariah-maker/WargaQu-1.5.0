                <!-- Top Navigation Bar -->
                <div class="flex items-center justify-between mb-4">
                    <button onclick="goBackMain()" class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 active:scale-95 flex items-center justify-center transition">
