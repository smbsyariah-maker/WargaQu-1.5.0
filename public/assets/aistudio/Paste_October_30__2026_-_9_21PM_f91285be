                    <div class="font-bold text-amber-900">Agenda RT Minggu Ini</div>
                    <div class="text-amber-700 mt-0.5">Gotong Royong Bersihkan Saluran Air - Minggu, 07:30 WIB di Lapangan RT 03.</div>
                </div>
            </div>

            <!-- KARTU KEUANGAN & KAS RT -->
            <div class="bg-white rounded-2xl p-4 border border-rtqu-100 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-rtqu-50 rounded-full -mr-8 -mt-8 pointer-events-none"></div>
                
                <div class="flex justify-between items-center mb-2">
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider flex items-center space-x-1">
                        <span>Ringkasan Kas RT 03</span>
                    </div>
                    <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full border border-emerald-200">
                        ● Live Updated
                    </span>
