                        <span class="text-[9px] text-slate-400 mt-0.5">KK & Pengurus</span>
                    </button>

                    <!-- Menu 3: Layanan Surat -->
                    <button onclick="openSubMenu('Layanan Surat', 'Pengajuan surat pengantar RT/RW secara daring.', 'surat')" class="flex flex-col items-center justify-center p-3 rounded-2xl bg-slate-50 hover:bg-emerald-50 border border-slate-100 hover:border-emerald-200 transition active:scale-95 group">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-100 group-hover:bg-rtqu-600 text-rtqu-700 group-hover:text-white flex items-center justify-center mb-2 transition shadow-sm">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        <span class="text-[11px] font-bold text-slate-700 text-center leading-tight">Surat RT</span>
                        <span class="text-[9px] text-slate-400 mt-0.5">Pengantar Online</span>
                    </button>

                    <!-- Menu 4: Agenda & Kegiatan -->
